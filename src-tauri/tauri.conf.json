{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LM.RENVIDAI",
  "version": "0.4.1",
  "identifier": "com.pennybuilder.localchat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LM.RENVIDAI",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": ["binaries/ollama"],
    "resources": ["resources/ollama-libs/**/*"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFRkYzNjM1NkUyMzE3NEQKUldSTkZ5TnVOVGIvWG5qMnhrZzZUcEx1TTd4NTdObGhvd0ozRGFtaDFzYTVSNTl2M0dBeEJadkUK",
      "endpoints": ["https://github.com/pennynguyen2023-crypto/local-ai-chat/releases/latest/download/latest.json"]
    }
  }
}
