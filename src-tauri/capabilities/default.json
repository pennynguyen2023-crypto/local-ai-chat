{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "autostart:default",
    "updater:default",
    "process:allow-relaunch",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ollama",
          "sidecar": true,
          "args": ["serve"]
        }
      ]
    }
  ]
}
